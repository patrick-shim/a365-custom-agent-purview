# Tenant containing OneDrive, Purview, and the Agent ID registrations.
ENTRA_TENANT_ID=
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8000/auth/callback
BLUEPRINT_CLIENT_ID=
BLUEPRINT_CLIENT_SECRET=
AGENT_IDENTITY_ID=
APP_NAME=onedrive-purview-agent
# Exact delegated API scope exposed by the blueprint, not a Graph scope.
# Example format: api://<BLUEPRINT_CLIENT_ID>/access_agent_as_user
# Replace the ID and scope name with values from your existing blueprint.
BLUEPRINT_SCOPE=
# Optional restriction to a test account; leave empty for other users in this tenant.
EXPECTED_USER=

# Tenant for your model deployment. No model key is required
# with azure_cli; sign in with az login --tenant <FOUNDRY_TENANT_ID>.
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_TENANT_ID=
FOUNDRY_AUTH_MODE=azure_cli
FOUNDRY_API_KEY=

# Must match the Application location targeted by the Purview DLP policy.
# Empty defaults to AGENT_IDENTITY_ID (the Graph OBO token's client identity).
PURVIEW_APP_ID=
REQUIRE_INLINE_OUTPUT=false
MAX_FILE_BYTES=131072
MAX_TEXT_BYTES=262144
TEST_FILE_PATH=test-summary.txt
